# Copy this to .env and fill in real values
# Never commit the .env file itself
OPENWEATHER_API_KEY=your-api-key-here

# Supabase → Connect → Session pooler URI, with your password filled in (see db/README.md)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:5432/postgres
